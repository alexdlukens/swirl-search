#!/bin/bash

set -e

# install nltk stopwords and punkt_tab resources
cp -r $SNAP/src $SNAP_DATA

# if $SNAP_DATA/envfile does not exist, create it
if [ ! -f $SNAP_DATA/src/envfile ]; then
  cp $SNAP/envfile $SNAP_DATA/src/envfile
  # use sed to update the SQL_DATABASE line by resolving the path
  # replace everything after SQL_DATABASE= with the path to the database in $SNAP_DATA
  sed -i "s|SQL_DATABASE=.*|SQL_DATABASE=${SNAP_DATA}/src/db.sqlite3|" $SNAP_DATA/src/envfile
  # ensure the database file path is correct
  echo "Created $SNAP_DATA/src/envfile from $SNAP/src/envfile"
else
  sed -i "s|SQL_DATABASE=.*|SQL_DATABASE=${SNAP_DATA}/src/db.sqlite3|" $SNAP_DATA/src/envfile
  echo "Using existing environment variables from $SNAP_DATA/src/envfile"
fi

# if $SNAP_DATA/src/db.sqlite3 does not exist, copy from $SNAP/db.sqlite3.dist
if [ ! -f $SNAP_DATA/src/db.sqlite3 ]; then
  cp $SNAP/db.sqlite3.dist $SNAP_DATA/src/db.sqlite3
  # ensure the database file is created
  echo "Created $SNAP_DATA/src/db.sqlite3 from $SNAP/db.sqlite3.dist"
else
  echo "Using existing database from $SNAP_DATA/src/db.sqlite3"
fi

# now run the setup
export $(cat $SNAP_DATA/src/envfile | xargs)
cd $SNAP_DATA/src && $SNAP/bin/python3 swirl.py setup
$SNAP_DATA/src/download-nltk-resources.sh
