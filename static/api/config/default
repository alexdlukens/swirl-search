                "date_published"
              ]
            },
            {
              "type": "json",
              "label": null,
              "fields": [
                "payload"
              ],
              "delimiter": ", "
            },
            {
              "type": "authorship",
              "fields": [
                "searchprovider",
                "searchprovider_rank",
                "author",
                "url"
              ]
            }
          ]
        ]
      ]
    ]
  },
  "facetLayout": [
    {
      "title": "Swirl Filters",
      "facets": [
        "Source"
      ]
    }
  ],
  "jsonFacet": {
    "Source": {
      "type": "terms",
      "displayField": "Source",
      "facetField": "searchprovider_rank"
    }
  },
  "defaultFilters": {
    "result_mixer": "result_mixer:RelevancyConfidenceMixer"
  },
  "cart": {
    "enabled": false,
    "addText": "Add to Cart...",
    "addImage": "assets/images/folder_into.png",
